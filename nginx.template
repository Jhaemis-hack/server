worker_processes auto;

events {
    worker_connections 1024;
}

http{
    server {
        listen ${PORT};  # Render or Koyeb will inject the PORT variable
        server_name _;

        location / {
            proxy_pass https://fast-api-nine-henna.vercel.app/;  # Change this to your Vercel app
            proxy_set_header Host $host;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}